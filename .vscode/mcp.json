{
  "servers": {
    "verimcp-devmcp": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m", "verimcp.cli",
        "--audit-log", "${workspaceFolder}/verimcp-audit.jsonl",
        "--otel-exporter", "console",
        "--",
